{
  "episode": "ep02-the-nature-of-elyra",
  "voice": "bm_lewis",
  "speed": 0.86,
  "pitch": 0.95,
  "lines": [
    {
      "at": 1.5,
      "file": "01.wav",
      "duration": 8,
      "played": 8.421052631578947,
      "text": "Elyra turns alone, far beyond every map of the stars. No moon has ever crossed its sky.",
      "hash": "53f8c9c33af0"
    },
    {
      "at": 10.8,
      "file": "02.wav",
      "duration": 8.425,
      "played": 8.86842105263158,
      "text": "Here, everything is lighter. Rain falls slowly, and the tides still rise, though nothing pulls them.",
      "hash": "8dd2b4e0a2a1"
    },
    {
      "at": 20.5,
      "file": "03.wav",
      "duration": 6.1,
      "played": 6.421052631578947,
      "text": "At night, its oceans glow faintly in the dark. No one knows why.",
      "hash": "a0b606414b68"
    },
    {
      "at": 27.7,
      "file": "04.wav",
      "duration": 5.5,
      "played": 5.7894736842105265,
      "text": "The ice at its poles is older than the light that falls upon it.",
      "hash": "a19f61ee3f50"
    },
    {
      "at": 34.3,
      "file": "05.wav",
      "duration": 6.875,
      "played": 7.236842105263158,
      "text": "And every ninety years, all of its volcanoes wake at once, like a single heartbeat.",
      "hash": "49fb74915d15"
    },
    {
      "at": 42.4,
      "file": "06.wav",
      "duration": 5.525,
      "played": 5.8157894736842115,
      "text": "Seventy-one realms lie waiting. No one has ever walked them.",
      "hash": "510794b07477"
    },
    {
      "at": 50,
      "file": "07.wav",
      "duration": 1.875,
      "played": 1.973684210526316,
      "text": "Not yet.",
      "hash": "4898a31229b9"
    }
  ]
}