  "lines": [
    {
      "at": 1.3,
      "file": "01.wav",
      "duration": 4.4,
      "played": 4.631578947368421,
      "text": "Every ninety years, Elyra's heart beats once.",
      "hash": "f6168a6f6ca3"
    },
    {
      "at": 7.2,
      "file": "02.wav",
      "duration": 4.975,
      "played": 5.2368421052631575,
      "text": "And when it does, every volcano wakes at the same instant.",
      "hash": "a3b92deee19f"
    },
    {
      "at": 13.6,
      "file": "03.wav",
      "duration": 4.85,
      "played": 5.105263157894736,
      "text": "Fire tears the sky open. Ash swallows the sun.",
      "hash": "a6b6b1338019"
    },
    {
      "at": 19.4,
      "file": "04.wav",
      "duration": 3.375,
      "played": 3.5526315789473686,
      "text": "For a long night, the world burns.",
      "hash": "f704c515c072"
    },
    {
      "at": 23.8,
      "file": "05.wav",
      "duration": 3.25,
      "played": 3.4210526315789473,
      "text": "But fire is not only an ending.",
      "hash": "e90bbb67d409"
    },
    {
      "at": 27.8,
      "file": "06.wav",
      "duration": 7.05,
      "played": 7.421052631578948,
      "text": "The ash falls on the land like a gift, and the light of the seas follows it into the soil.",
      "hash": "de6e59c3e336"
    },
    {
      "at": 36.2,
      "file": "07.wav",
      "duration": 4.425,
      "played": 4.657894736842105,
      "text": "When the sun returns, something green is waiting.",
      "hash": "0f3a7e5d924d"
    }
  ]
}