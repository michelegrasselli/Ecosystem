  "narration": {
    "voice": "bm_lewis",
    "speed": 0.86,
    "captions": true,
    "captionSize": 0.6,
    "lines": [
      {
        "at": 1.8,
        "text": "Far beyond every map of the stars, Elyra turns alone in the dark."
      },
      {
        "at": 9.1,
        "text": "A world of six thousand four hundred kilometres in radius. No moon lights its nights."
      },
      {
        "at": 17.9,
        "text": "Its gravity is gentle. Here, every stone weighs a little less, and every wave climbs a little higher."
      },
      {
        "at": 27.9,
        "text": "A day lasts twenty-nine hours. A year, three hundred and seventy-seven days."
      },
      {
        "at": 36,
        "text": "More than half of its face is water. Oceans seven kilometres deep, where no light has ever reached."
      },
      {
        "at": 46,
        "text": "On the land, rivers carve their way through green valleys, toward the sea."
      },
      {
        "at": 53.4,
        "text": "Further on, the deserts burn beneath a white sun."
      },
      {
        "at": 59.1,
        "text": "At the edges of the world, the ice has never melted. And the mountains climb above nine thousand metres."
      },
      {
        "at": 69.2,
        "text": "Forty-six volcanoes rise from its skin. Twenty-one of them still burn."
      },
      {
        "at": 76.8,
        "text": "Its land is already divided into seventy-one realms. But no one has ever walked them."
      },
      {
        "at": 86.3,
        "text": "Not yet."
      }
    ]
  },
