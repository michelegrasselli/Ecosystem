  "narration": {
    "voice": "bm_lewis",
    "speed": 0.86,
    "captions": true,
    "captionSize": 0.6,
    "lines": [
      {
        "at": 1.5,
        "text": "Elyra turns alone, far beyond every map of the stars. No moon has ever crossed its sky."
      },
      {
        "at": 10.8,
        "text": "Here, everything is lighter. Rain falls slowly, and the tides still rise, though nothing pulls them."
      },
      {
        "at": 20.5,
        "text": "At night, its oceans glow faintly in the dark. No one knows why."
      },
      {
        "at": 27.7,
        "text": "The ice at its poles is older than the light that falls upon it."
      },
      {
        "at": 34.3,
        "text": "And every ninety years, all of its volcanoes wake at once, like a single heartbeat."
      },
      {
        "at": 42.4,
        "text": "Seventy-one realms lie waiting. No one has ever walked them."
      },
      {
        "at": 50,
        "text": "Not yet."
      }
    ]
  },
