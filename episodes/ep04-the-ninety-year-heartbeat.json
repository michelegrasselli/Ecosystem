  "narration": {
    "voice": "bm_lewis",
    "speed": 0.86,
    "captions": true,
    "captionSize": 0.6,
    "lines": [
      {
        "at": 1.3,
        "text": "Every ninety years, Elyra's heart beats once."
      },
      {
        "at": 7.2,
        "text": "And when it does, every volcano wakes at the same instant."
      },
      {
        "at": 13.6,
        "text": "Fire tears the sky open. Ash swallows the sun."
      },
      {
        "at": 19.4,
        "text": "For a long night, the world burns."
      },
      {
        "at": 23.8,
        "text": "But fire is not only an ending."
      },
      {
        "at": 27.8,
        "text": "The ash falls on the land like a gift, and the light of the seas follows it into the soil."
      },
      {
        "at": 36.2,
        "text": "When the sun returns, something green is waiting."
      }
    ]
  },
